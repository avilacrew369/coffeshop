---
import "@/styles/global.css";
import Header from "@/components/ui/Header.astro";
import Footer from "@/components/ui/Footer.astro";

interface Props {
    title: string;
    subtitle: string;
    bgImage: string;
}
const { title, subtitle,  bgImage } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Panther Coffee: {title}</title>
        <link rel="icon" type="image/x-icon" href="/onepant.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=PT+Sans:wght@400;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css"
        />
    </head>
    <body class="bg-coffee-200">

        <Header 
            bgImage={bgImage}
            subtitle={subtitle}
         />
         <main class="bg-white p-20 max-w-7xl mx-auto lg:-mt-20 relative">
             <h2 class="text-4xl font-black text-center text-coffee-900 pb-10 after:coffee-icon">{title}</h2>
             <slot />

         </main>
         <slot name="after-main-contents"/>
        <Footer />
    </body>
</html>
