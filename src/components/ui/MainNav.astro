---
const navigation = [
  {name: 'Inicio', href: '/' },
  {name: 'Nosotros', href: '/nosotros/' },
  {name: 'Blog', href: '/blog/' },
  {name: 'Proceso', href: '/proceso/' },
  {name: 'Menú', href: '/menu/' },
  {name: 'Galería', href: '/galeria/' },
  {name: 'Contacto', href: '/contacto/' },
]
---

<nav class="flex flex-col lg:flex-row  justify-center items-center gap-4">
    {navigation.map(item => 
    <a 
        href={item.href}
        class="uppercase text-lg font-bold text-white hover:text-white/70 transition-colors duration-300"
        >{item.name}</a>)}
</nav>