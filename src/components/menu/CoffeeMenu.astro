---
import { MenuItemsSchema } from "@/types"
import MenuItem from "./MenuItem.astro"


const url = `http://coffeshop.local/wp-json/wp/v2/products?product_categories=8`
const res = await fetch(url)
const json = await res.json()
const data = MenuItemsSchema.parse(json)

---

<div>
    <div class="text-white  text-center text-4xl font-blak uppercase my-10">Café </div>
    <ul id="cafe"  class="space-y-3">
        {data.map((item) => (
            <MenuItem 
                title={item.title.rendered} 
                description={item.acf.description}
                price={item.acf.price}
                image={item.featured_images}
            />
        ))}

    </ul>
</div>


<script>
    import PhotoSwipeLightBox from 'photoswipe/lightbox'
    import 'photoswipe/style.css'

    const lightbox = new PhotoSwipeLightBox({
        gallery: '#cafe',
        children: 'a',
        pswpModule: () => import('photoswipe')
    })
    lightbox.init();
    document.addEventListener("astro:page-load", function () {
        lightbox.init();
    });
</script>