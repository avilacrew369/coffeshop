---
import CoffeeMenu from "./CoffeeMenu.astro";
import FoodMenu from "./FoodMenu.astro";


---

<section class="bg-coffee-800 py-10 -mt-20">
    <div class="max-w-7xl mx-auto bg-menu-image bg-no-repeat bg-contain bg-position-[center_80px] pt-37.5 lg:pt-62.5 pb-40">
        <h3 class="text-coffee-300 font-black text-center text-xl pb-4 uppercase mt-10" >
            Nuestro Delicioso 
            <span class="text-4xl block text-coffee-500" >Menu</span>
        </h3>
        <div class="grid grid-cols-1 2xl:grid-cols-2 gap-5 mt-10">
            <CoffeeMenu />
            <FoodMenu />
        </div>
    </div>

</section>